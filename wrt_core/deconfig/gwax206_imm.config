# ==================== 1. 设备基础与启动关键 (核心修复) ====================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7622=y
CONFIG_TARGET_mediatek_mt7622_DEVICE_netgear_wax206=y

# 核心稳定性补丁：防止循环重启
CONFIG_KERNEL_NVMEM=y
CONFIG_KERNEL_NVMEM_SYSFS=y
CONFIG_KERNEL_NVMEM_LAYOUT_FIXED=y
CONFIG_KERNEL_MTD_SPI_NAND_BMT=y
CONFIG_KERNEL_NET_RANDOM_ETHADDR=y
CONFIG_KERNEL_SMP=y

# 存储分区优化
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=448

# ==================== 2. MediaTek 硬件加速 (HNAT) ====================
# TurboACC 核心包及中文语言
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y

# 确保其依赖的底层加速模块全部勾选
CONFIG_PACKAGE_kmod-mtk-hnat=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-mt7530=y

# ==================== 3. 性能与内存优化 (建议项) ====================
# A53 调频插件
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# 内存压力缓解 (ZRAM)
CONFIG_KERNEL_SWAP=y
CONFIG_KERNEL_ZRAM=y
CONFIG_PACKAGE_zram-swap=y

# 系统统计与监控
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y

# ==================== 4. 无线驱动与固件 (Wi-Fi 6) ====================
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wpad-mbedtls=y

# ==================== 5. ImmortalWrt 特色插件 (OpenClash 等) ====================
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_coreutils-base64=y

# ==================== 6. 界面与工具箱 ====================
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-package-manager=y

# 实用系统工具
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ethtool-full=y
