# ==================== 设备基础（Netgear WAX206） ====================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7622=y
CONFIG_TARGET_mediatek_mt7622_DEVICE_netgear_wax206=y
CONFIG_LINUX_6_12=y

# ==================== 编译优化（CCACHE 缓存） ====================
CONFIG_CCACHE=y

# 根文件系统 - 启动必需
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=768

# NVMEM/MTD 启动关键配置
CONFIG_KERNEL_NVMEM=y
CONFIG_KERNEL_NVMEM_SYSFS=y
CONFIG_KERNEL_NVMEM_LAYOUT_FIXED=y
CONFIG_KERNEL_MTD_SPI_NAND_BMT=y
CONFIG_KERNEL_NET_RANDOM_ETHADDR=y
CONFIG_KERNEL_SMP=y

# 架构特性
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_ARCH="aarch64"
CONFIG_CPU_TYPE="cortex-a53"
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"
CONFIG_HAS_FPU=y
CONFIG_USES_DEVICETREE=y
CONFIG_USES_SQUASHFS=y
CONFIG_NAND_SUPPORT=y
CONFIG_EMMC_SUPPORT=y

# ==================== 包管理 (OpenWrt 24.10) ====================
CONFIG_USE_APK=y
CONFIG_PACKAGE_apk-mbedtls=y

# ==================== 基础系统（精简保留） ====================
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_fwtool=y
CONFIG_PACKAGE_getrandom=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_procd-seccomp=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y

# ==================== 网络核心与无缝漫游 (802.11k/v/r) ====================
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables-mod-extra=y

# [关键修改] 替换 wpad-basic 为支持 k/v/r 的版本
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mesh-mbedtls=y

# 无线驱动 - WAX206 必需
CONFIG_PACKAGE_kmod-mt7622-firmware=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_wireless-regdb=y

# 交换机与物理层
CONFIG_PACKAGE_kmod-mt7530=y
CONFIG_PACKAGE_kmod-phy-realtek=y

# ==================== 主要定制：OpenClash ====================
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base4=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-tun=y

# ==================== 主要定制：Argon 主题 & 界面 ====================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y

# 实用工具avahi添加（强烈建议添加，方便你的插件通过命令行抓取设备名）
CONFIG_PACKAGE_avahi-utils=y
CONFIG_PACKAGE_luci-app-avahi=y

# 核心守护进程（基于 DBus，功能最全）
CONFIG_PACKAGE_avahi-dbus-daemon=y

# 必备依赖（通常会自动勾选，但建议检查）
CONFIG_PACKAGE_libavahi-client=y
CONFIG_PACKAGE_libavahi-dbus-support=y
CONFIG_PACKAGE_dbus=y

# 中文支持
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-avahi-zh-cn=y

# 添加nlbwmon网络监控
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y  # 简体中文语言包（可选但推荐）

# ==================== 自定义插件：设备管理 ====================
CONFIG_PACKAGE_luci-app-devicemaster=y

# ==================== 实用工具 & 硬件加速 ====================
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_yq=y

# [新增] LAN口 LED 硬件控制驱动与工具
CONFIG_PACKAGE_kmod-leds-mt7531=y
CONFIG_PACKAGE_mdio-tools=y

# [新增] 流量分流加速 (Bypass OpenClash 时的 CPU 占用优化)
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nft-offload=y

# ==================== 【新增】TC 流量控制工具 ====================
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-fq=y
CONFIG_PACKAGE_kmod-sched-fq-codel=y

# ==================== 【新增】SQM 智能队列（抗 bufferbloat，游戏延迟保护） ====================
# ifb 用于下行 ingress 限速；SNAPSHOT 在线装 kmod 会因内核哈希不匹配失败，必须编译进固件
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

# ==================== 【新增】usteer 同 SSID 双频智能引导 ====================
# 引导 5G 信号良好的设备固定到 5G 频段，避免漫游到拥挤的 2.4G 导致游戏跳 ping
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_luci-app-usteer=y

# ==================== luci-app-bandix网络监控 ====================
CONFIG_PACKAGE_luci-app-bandix=y
CONFIG_PACKAGE_bandix=y
CONFIG_PACKAGE_luci-lib-jsonc=y
# bandix 依赖包（来自 Makefile: DEPENDS:=+zoneinfo-all +conntrack +iw）
CONFIG_PACKAGE_zoneinfo-all=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_iw=y
# luci-app-bandix 依赖包（来自 README: curl, luci-lib-jsonc, jsonfilter, jshn）
CONFIG_PACKAGE_jshn=y
# ==================== 内核网络模块 ====================
CONFIG_KERNEL_IPV6=y
CONFIG_KERNEL_MPTCP=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_NAMESPACES=y

# ==================== 【新增】内核 BTF（honk/dae 等 eBPF CO-RE 程序必需） ====================
# 开启后内核暴露 /sys/kernel/btf/vmlinux，honk 无需外挂 vmlinux-btf 包；
# 同时满足 native-api UDP 追踪所需的内核 BTF（可选增强，缺失时自动降级）。
# BTF 依赖 DEBUG_INFO 且不能启用 DEBUG_INFO_REDUCED（默认 y，必须显式关掉）。
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y

# Netfilter 核心
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nat=y

# ==================== 库依赖（OpenClash 必需） ====================
CONFIG_PACKAGE_libmbedtls=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libcurl=y
CONFIG_LIBCURL_MBEDTLS=y
CONFIG_LIBCURL_NGHTTP2=y
CONFIG_PACKAGE_libnghttp2=y
CONFIG_PACKAGE_libev=y
CONFIG_PACKAGE_libsodium=y
CONFIG_PACKAGE_liblua=y
CONFIG_PACKAGE_libpcre2=y
CONFIG_PACKAGE_libyaml=y
CONFIG_PACKAGE_zlib=y

# ==================== 【新增】honk eBPF 透明代理（与 dae 同源，带 doona 面板） ====================
# 内核已具备 BPF_SYSCALL / BPF JIT / CGROUP_BPF / NET_XGRESS / NET_CLS_ACT（实测 tcx 符号存在），
# 这里只需补齐 datapath 与 NFQUEUE 暂存所缺的模块（SNAPSHOT 不能在线装 kmod，必须编译进固件）。
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y

# honk 主程序与 LuCI 界面：来自 kenzok8/small 源（feeds.sh 选择性安装）
# 该包自带 update-pkg.sh / update-geo.sh，可在 LuCI 面板内更新内核与 geo 数据
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y

# ==================== 其他保留项 ====================
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-thermal=y

# ==================== OpenSSH 支持（完整） ====================
# 注意：Dropbear 和 OpenSSH 可以共存，但需要配置端口
# Dropbear 默认端口 22，OpenSSH 需要改端口或禁用 Dropbear
# 这里保留 Dropbear 作为默认 SSH，OpenSSH 用于 SFTP 功能
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-keygen=y
# 可选：如果需要完整的 OpenSSH 服务器（替代 Dropbear）
# CONFIG_PACKAGE_openssh-server=y

# ==================== 文件传输工具 ====================
# scp 需要 openssh-client，已在上面配置
# rz/sz 用于终端文件传输（zmodem 协议）
CONFIG_PACKAGE_lrzsz=y
# tar 用于打包解包
CONFIG_PACKAGE_tar=y
# zip 用于压缩
CONFIG_PACKAGE_zip=y
